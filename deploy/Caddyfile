# ==============================================================================
# Caddy Ingress Configuration
# ==============================================================================
# Automatic HTTPS via Let's Encrypt / ZeroSSL. HTTP/3 is intentionally disabled
# because iOS Network.framework clients can select the advertised QUIC path and
# remain stuck when the host/network cannot complete UDP/443.
# Domain variables can be customized in deploy/.env
# ==============================================================================

{
    email {$ACME_EMAIL:devops@akaiunsan.vn}

    # Keep HTTPS on HTTP/1.1 and HTTP/2. Do not advertise h3/QUIC until the
    # production UDP/443 path is verified for the mobile client fleet.
    servers {
        protocols h1 h2
    }
}

# Reusable security headers
(security) {
    encode zstd gzip
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Alt-Svc
        -Server
    }
}

# ------------------------------------------------------------------------------
# Backend REST API
# ------------------------------------------------------------------------------
{$DOMAIN_API:api.akaiunsan.vn} {
    import security

    # Uploads limit (e.g., 20MB for helper profile images / KYC documents)
    request_body {
        max_size 20MB
    }

    # Automatic Deployment Webhook
    handle /webhook/deploy* {
        reverse_proxy host.docker.internal:9000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
        }
    }

    # Default: Reverse proxy to Express API
    handle {
        reverse_proxy backend:5000 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# ------------------------------------------------------------------------------
# Admin Back-Office Portal
# ------------------------------------------------------------------------------
{$DOMAIN_ADMIN:admin.akaiunsan.vn} {
    import security

    reverse_proxy admin:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}

# ------------------------------------------------------------------------------
# Customer Web Portal
# ------------------------------------------------------------------------------
{$DOMAIN_FRONTEND:akaiunsan.com} {
    import security
    reverse_proxy frontend:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}
