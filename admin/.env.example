VITE_CLERK_PUBLISHABLE_KEY=
# Backend API origin the dashboard calls (default: http://localhost:5000 in dev,
# https://akai-api.cjs.vn in production builds)
VITE_API_BASE_URL=
# Shared app_key header value — must match `app_key` in the backend config
# (backend/config/<env>.json). Never commit the real value.
VITE_APP_KEY=
# Sentry error monitoring override (built-in default DSN is compiled in)
VITE_SENTRY_DSN=
