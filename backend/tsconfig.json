{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022"],
    "rootDir": ".",
    "outDir": "dist",
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strict": false,
    "strictNullChecks": false,
    "types": ["node"]
  },
  "include": ["app.ts", "routes/**/*", "controllers/**/*", "middlewares/**/*", "models/**/*", "helpers/**/*"],
  "exclude": ["node_modules", "dist", "tests", "coverage", "exports", "uploads"]
}
