  "main": "app.ts",
  "scripts": {
    "local": "NODE_ENV=local tsx app.ts",
    "test": "NODE_ENV=test vitest run",
    "dev": "NODE_ENV=development tsx watch app.ts",
    "prod": "NODE_ENV=production tsx app.ts",
    "postinstall": "patch-package",
    "test:watch": "NODE_ENV=test vitest",
    "test:coverage": "NODE_ENV=test vitest run --coverage",
    "build": "(tsc || true) && node scripts/fix-dist-requires.js",
    "typecheck": "tsc --noEmit"
  },
  "betterScripts": {
    "local": {
      "env": {
        "NODE_ENV": "local"
      },
      "command": "node app.js"
    },
    "dev": {
      "env": {
        "NODE_ENV": "development"
      },
      "command": "node app.js"
    },
    "prod": {
      "env": {
        "NODE_ENV": "production"
      },
      "command": "node app.js"
    }
  },
