# ==============================================================================
# Master Deployment Environment Configuration
# ==============================================================================
# Copy this file to `.env` in the deploy/ directory on your VPS:
#   cp .env.example .env
#   chmod 600 .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Domains & TLS (Caddy Automatic SSL)
# ------------------------------------------------------------------------------
ACME_EMAIL=devops@ayasan.vn
DOMAIN_API=api.ayasan.vn
DOMAIN_ADMIN=admin.ayasan.vn
DOMAIN_FRONTEND=ayasan.vn

# ------------------------------------------------------------------------------
# 2. Container Images (Registry Mode)
# ------------------------------------------------------------------------------
# If deploying prebuilt images from GitHub Container Registry (ghcr.io):
IMAGE_BACKEND=ghcr.io/streamentry/akaiunsan-backend:latest
IMAGE_FRONTEND=ghcr.io/streamentry/akaiunsan-frontend:latest
IMAGE_ADMIN=ghcr.io/streamentry/akaiunsan-admin:latest

# ------------------------------------------------------------------------------
# 3. Database Credentials (MariaDB)
# ------------------------------------------------------------------------------
DB_ROOT_PASSWORD=generate_a_secure_root_password_here
DB_NAME=ayasan_db_prod
DB_USER=ayasan_user
DB_PASSWORD=generate_a_secure_user_password_here

# ------------------------------------------------------------------------------
# 4. Backend Application Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000

# Backend DB connection (points to the 'mariadb' container service name)
DB_HOST=mariadb
DB_PORT=3306

# Security & Secrets (Must be rotated in production)
JWT_SECRET=your_production_jwt_secret_min_32_chars
APP_KEY=your_production_app_key_secret

# Optional Integrations
OMISE_SECRET_KEY=
OMISE_PUBLIC_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
